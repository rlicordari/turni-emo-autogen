# Rename this file to secrets.toml and place it in .streamlit/
# On Streamlit Community Cloud, set these keys under App -> Settings -> Secrets.

# GitHub storage (private repo suggested)
GITHUB_TOKEN = "ghp_..."
GITHUB_REPO  = "OWNER/REPO"
GITHUB_BRANCH = "main"
GITHUB_DATA_PATH = "data/unavailability.json"

# PINs for doctors (and the test user). Keep them private.
[DOCTOR_PINS]
"Vizzari" = "1111"
"Virga" = "1111"
"Carciotto" = "1111"
"Giusti" = "1111"
"De Luca" = "1111"
"Saporito" = "1111"
"Utente Test" = "0000"

# Admin PIN (for generating schedules)
ADMIN_PIN = "9999"
